PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/studio_north
CLIENT_ORIGIN=http://127.0.0.1:5173
BUSINESS_TIMEZONE=America/Los_Angeles

# Booking policy (minimum lead in minutes; rolling UTC horizon in days)
BOOKING_LEAD_MINUTES=60
BOOKING_HORIZON_DAYS=60
BOOKING_RATE_LIMIT_MAX=10

# Protected administration (Secure cookies default on in production)
SESSION_MINUTES=60
# SESSION_COOKIE_SECURE=true
# ADMIN_EMAIL and ADMIN_INITIAL_PASSWORD are runtime-only admin:setup inputs.
# Never publish a password or add a public registration endpoint.

# Explicit isolated demo mode; normal database never reset.
DEMO_MODE=false
# DEMO_DATABASE=studio_north_demo_local
# DEMO_RESET_CONFIRM=RESET DEMO (runtime-only reset confirmation)
