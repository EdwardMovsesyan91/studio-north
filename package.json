{
  "name": "studio-north",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.21.0",
  "scripts": {
    "dev": "concurrently --kill-others --names client,server \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "check": "npm run lint && npm run typecheck && npm run build",
    "test": "npm run test --workspace server",
    "test:integration": "npm run test:integration --workspace server",
    "seed:dev": "npm run seed --workspace server",
    "admin:setup": "npm run admin:setup --workspace server",
    "demo:reset": "npm run demo:reset --workspace server"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
